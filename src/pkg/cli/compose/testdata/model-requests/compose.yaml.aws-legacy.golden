name: modeldemo
services:
  app:
    depends_on:
      chat:
        condition: service_started
        required: true
      embed:
        condition: service_started
        required: true
    environment:
      CHAT_MODEL: bedrock/us.amazon.nova-2-lite-v1:0
      CHAT_URL: https://proxy.example/v1/
      EMBED_BASE_URL: http://mock-embed:4000/v1/
      EMBED_MODEL_NAME: bedrock/amazon.titan-embed-text-v2:0
      OPENAI_API_KEY: networkisalreadyprivate
    image: app
    models:
      chat: null
      embed:
        endpoint_var: EMBED_BASE_URL
        model_var: EMBED_MODEL_NAME
    networks:
      default: null
      model_provider_private: null
  chat:
    command:
      - --drop_params
      - --model
      - bedrock/us.amazon.nova-2-lite-v1:0
      - --alias
      - chat-default
    deploy:
      resources:
        reservations:
          cpus: 0.5
          memory: "2147483648"
    environment:
      AWS_REGION: us-west-2
      LITELLM_MASTER_KEY: networkisalreadyprivate
    image: litellm/litellm:v1.92.0
    networks:
      model_provider_private: null
    ports:
      - mode: host
        target: 4000
        protocol: tcp
    x-defang-llm: true
  embed:
    command:
      - --drop_params
      - --model
      - bedrock/amazon.titan-embed-text-v2:0
      - --alias
      - embedding-default
    deploy:
      resources:
        reservations:
          cpus: 0.5
          memory: "2147483648"
    environment:
      AWS_REGION: us-west-2
      LITELLM_MASTER_KEY: networkisalreadyprivate
    image: litellm/litellm:v1.92.0
    networks:
      model_provider_private: null
    ports:
      - mode: host
        target: 4000
        protocol: tcp
    x-defang-llm: true
  exact:
    command:
      - --drop_params
      - --model
      - bedrock/us.amazon.nova-2-lite-v1:0
      - --alias
      - us.amazon.nova-2-lite-v1:0
    deploy:
      resources:
        reservations:
          cpus: 0.5
          memory: "2147483648"
    environment:
      AWS_REGION: us-west-2
      LITELLM_MASTER_KEY: networkisalreadyprivate
    image: litellm/litellm:v1.92.0
    networks:
      model_provider_private: null
    ports:
      - mode: host
        target: 4000
        protocol: tcp
    x-defang-llm: true
  large:
    command:
      - --drop_params
      - --model
      - bedrock/zai.glm-5
      - --alias
      - chat-large
    deploy:
      resources:
        reservations:
          cpus: 0.5
          memory: "2147483648"
    environment:
      AWS_REGION: us-west-2
      LITELLM_LOG: DEBUG
      LITELLM_MASTER_KEY: networkisalreadyprivate
    image: litellm/litellm:v1.92.0
    networks:
      model_provider_private: null
    ports:
      - mode: host
        target: 4000
        protocol: tcp
  worker:
    depends_on:
      chat:
        condition: service_started
        required: true
      exact:
        condition: service_started
        required: true
      large:
        condition: service_started
        required: true
    environment:
      CHAT_URL: http://mock-chat:4000/v1/
      EXACT_MODEL: bedrock/us.amazon.nova-2-lite-v1:0
      EXACT_URL: http://mock-exact:4000/v1/
      LARGE_MODEL: my-pinned-name
      LARGE_URL: http://mock-large:4000/v1/
      OPENAI_API_KEY: networkisalreadyprivate
      WORKER_CHAT_MODEL: bedrock/us.amazon.nova-2-lite-v1:0
    image: worker
    models:
      chat:
        model_var: WORKER_CHAT_MODEL
      exact: null
    networks:
      default: null
      model_provider_private: null
networks:
  default:
    name: modeldemo_default
  model_provider_private:
    name: model_provider_private
models:
  chat:
    model: ai/chat-default
  embed:
    model: embedding-default
  exact:
    model: us.amazon.nova-2-lite-v1:0
