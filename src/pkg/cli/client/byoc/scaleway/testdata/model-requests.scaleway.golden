name: modeldemo
services:
  app:
    environment:
      CHAT_URL: https://proxy.example/v1/
      EMBED_BASE_URL: https://api.scaleway.ai/v1/
      OPENAI_API_KEY: null
    image: app
    networks:
      default: null
  chat:
    x-defang-llm:
      model: ai/chat-default
      bindings:
        - consumer: app
          model_var: CHAT_MODEL
          endpoint_var: CHAT_URL
          supplied:
            - model
        - consumer: worker
          model_var: WORKER_CHAT_MODEL
          endpoint_var: CHAT_URL
          supplied:
            - model
            - endpoint
  embed:
    x-defang-llm:
      model: embedding-default
      bindings:
        - consumer: app
          model_var: EMBED_MODEL_NAME
          endpoint_var: EMBED_BASE_URL
          supplied:
            - model
            - endpoint
  exact:
    x-defang-llm:
      model: us.amazon.nova-2-lite-v1:0
      bindings:
        - consumer: worker
          model_var: EXACT_MODEL
          endpoint_var: EXACT_URL
          supplied:
            - model
            - endpoint
  large:
    x-defang-llm:
      model: chat-large
      bindings:
        - consumer: worker
          model_var: LARGE_MODEL
          endpoint_var: LARGE_URL
          supplied:
            - endpoint
  worker:
    environment:
      CHAT_URL: https://api.scaleway.ai/v1/
      EXACT_URL: https://api.scaleway.ai/v1/
      LARGE_MODEL: my-pinned-name
      LARGE_URL: https://api.scaleway.ai/v1/
      OPENAI_API_KEY: null
    image: worker
    networks:
      default: null
networks:
  default:
    name: modeldemo_default
